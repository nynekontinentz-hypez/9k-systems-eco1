# ──────────────────────────────────────────────────────────────
# 9K Systems — environment
# Copy to .env.local and fill in. Never commit .env.local.
# ──────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk — auth + organizations (each SMB client = one Clerk Organization)
# Dashboard: https://dashboard.clerk.com -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/app
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/app

# Supabase — Postgres + Storage (gated downloads)
# Dashboard: https://supabase.com/dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxx
# Storage bucket for client deliverables (create as a PRIVATE bucket).
SUPABASE_DELIVERABLES_BUCKET=deliverables

# Stripe — payments
# Dashboard: https://dashboard.stripe.com -> Developers -> API keys
STRIPE_SECRET_KEY=sk_test_xxx
# From `stripe listen` or the webhook endpoint settings.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Studio AI script generator (provider-agnostic).
# provider: gemini (free, recommended) | groq | openai | anthropic
STUDIO_AI_PROVIDER=gemini
STUDIO_AI_API_KEY=
# Optional model override; sensible per-provider defaults are used if blank.
STUDIO_AI_MODEL=
