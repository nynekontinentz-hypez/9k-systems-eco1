# ──────────────────────────────────────────────────────────────
# 9K Systems — environment
# Copy to .env.local and fill in. Never commit .env.local.
# ──────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk — auth + organizations (each SMB client = one Clerk Organization)
# Dashboard: https://dashboard.clerk.com -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/app
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/app

# Supabase — Postgres + Storage (gated downloads)
# Dashboard: https://supabase.com/dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxx
# Storage bucket for client deliverables (create as a PRIVATE bucket).
SUPABASE_DELIVERABLES_BUCKET=deliverables

# Stripe — payments
# Dashboard: https://dashboard.stripe.com -> Developers -> API keys
STRIPE_SECRET_KEY=sk_test_xxx
# From `stripe listen` or the webhook endpoint settings.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Studio AI script generator (provider-agnostic).
# "Fast" / supplied tier — the default key clients use out of the box.
# provider: gemini (free, recommended) | groq | openai | anthropic
STUDIO_AI_PROVIDER=gemini
STUDIO_AI_API_KEY=
# Optional model override; sensible per-provider defaults are used if blank.
STUDIO_AI_MODEL=

# "Premium" supplied tier (optional). If the key is blank, Premium falls back
# to Fast. Point this at a higher-quality model, e.g. openai / gpt-4o.
STUDIO_AI_PREMIUM_PROVIDER=
STUDIO_AI_PREMIUM_API_KEY=
STUDIO_AI_PREMIUM_MODEL=

# BYOK: master key to encrypt clients' own provider keys at rest (AES-256-GCM).
# 32 bytes as 64 hex chars or base64. Generate: `openssl rand -hex 32`.
# Leave blank to disable bring-your-own-key entirely.
STUDIO_AI_ENC_KEY=

# Monthly per-tenant cap on SUPPLIED-key generations (BYOK is never capped).
STUDIO_AI_MONTHLY_CAP=30
# Entitlement SKUs that unlock supplied AI (comma-separated). Blank = any active
# entitlement qualifies.
STUDIO_AI_GATE_SKUS=
# Clerk user ids that bypass the gate AND the cap (you/operators, comma-separated).
STUDIO_AI_UNLIMITED_USERS=

# Studio render worker (open-source voiceover/video pipeline). Deploy the
# container in /worker to any host, then set its public URL + a shared secret.
# The same STUDIO_WORKER_SECRET must be set on the worker. Generate: openssl rand -hex 32
STUDIO_WORKER_URL=
STUDIO_WORKER_SECRET=
